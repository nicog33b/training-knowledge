# Copia a .env (no se versiona). Las APIs se pagan por token, aparte de las suscripciones
# de Claude o ChatGPT. Configura uno o varios proveedores: el chat deja elegir entre los que tengan clave.
# Para probar la UI sin gastar: pnpm dev:fake

# ── Claude (Anthropic) · tutor: claude-haiku-5-5
ANTHROPIC_API_KEY=

# ── ChatGPT (OpenAI) · tutor: gpt-6-luna (mismo precio que Haiku 5.5)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini          # cambia el modelo del nivel rápido (tutor)
# OPENAI_NO_EXTRA=1                # no enviar reasoning_effort (modelos que no lo aceptan)

# ── Gemini (endpoint compatible con OpenAI) · sin equivalencia verificada: elige el modelo
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_PRICE_IN=0.10             # USD por millón de tokens, para el contador de gasto
# GEMINI_PRICE_OUT=0.40

# ── Ollama (local, gratis)
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Cualquier otro servidor compatible con OpenAI (OpenRouter, Groq, DeepSeek, LM Studio…)
# COMPAT_BASE_URL=https://…/v1
# COMPAT_API_KEY=
# COMPAT_MODEL=
# COMPAT_PRICE_IN=
# COMPAT_PRICE_OUT=

# ── Modelos por nivel (rápido: tutor · potente: simulaciones a medida, futuro)
# <PROVEEDOR>_MODEL_RAPIDO= · <PROVEEDOR>_MODEL_EQUILIBRADO= · <PROVEEDOR>_MODEL_POTENTE=

# ── Servidor del tutor
# TUTOR_PROVIDER=openai             # proveedor predeterminado si hay varios
# TUTOR_PORT=4322
# TUTOR_ORIGIN=http://localhost:4321
