---
/**
 * Tarjetas de repaso (una cara → la otra → ¿la sabías?). Las marcas alimentan el repaso espaciado
 * del curso (lib/srs.ts → @tk/practice). Añade las tarjetas personales creadas desde el menú de selección.
 *   mode="all": todas · mode="due": solo vencidas o nuevas, en orden de sesión (intercaladas por subtema).
 * Decisiones: practica-de-recuperacion, repeticion-espaciada-fsrs, intercalar-conceptos-confundibles.
 */
export interface Card { key: string; front: string; back: string; group: string; label?: string }
interface Props { cards: Card[]; module: string; topic?: string; mode?: 'all' | 'due'; limit?: number; userCards?: boolean }
const { cards, module, topic = '', mode = 'all', limit = 20, userCards = true } = Astro.props;
---
<div class="fc" data-fc data-module={module} data-topic={topic} data-mode={mode} data-limit={limit} data-user={userCards ? '1' : ''}>
  <script type="application/json" set:html={JSON.stringify(cards).replace(/</g, '\\u003c')} />
  <div class="fc-bar">
    <span class="fc-count muted" aria-live="polite"></span>
    <div class="fc-nav">
      <button type="button" class="fc-btn" data-act="prev" aria-label="Anterior">←</button>
      <button type="button" class="fc-btn" data-act="shuffle" title="Barajar">⤮</button>
      <button type="button" class="fc-btn" data-act="next" aria-label="Siguiente">→</button>
    </div>
  </div>
  <div class="fc-stage">
    <button type="button" class="fc-card" aria-live="polite">
      <span class="fc-label"></span>
      <span class="fc-face fc-front"></span>
      <span class="fc-face fc-back" hidden></span>
      <span class="fc-hint">Piensa la respuesta · toca o pulsa Espacio para girar</span>
    </button>
  </div>
  <div class="fc-rate" role="group" aria-label="¿La sabías?" hidden>
    <button type="button" data-rate="no">No <kbd>1</kbd></button>
    <button type="button" data-rate="casi">Más o menos <kbd>2</kbd></button>
    <button type="button" data-rate="si">Sí <kbd>3</kbd></button>
  </div>
  <p class="fc-empty muted" hidden></p>
</div>

<style is:global>
  .fc { --r: 16px; }
  .fc-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: .5rem; }
  .fc-nav { display: flex; gap: .3rem; }
  .fc-btn { font: inherit; width: 34px; height: 34px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg); color: var(--fg); cursor: pointer; }
  .fc-btn:hover { border-color: var(--accent); color: var(--accent); }
  .fc-stage { perspective: 1200px; }
  .fc-card { width: 100%; min-height: 220px; display: grid; place-items: center; gap: .6rem; text-align: center; font: inherit; color: var(--fg); cursor: pointer;
    background: linear-gradient(160deg, var(--card), var(--bg)); border: 1px solid var(--line); border-radius: var(--r); padding: 1.6rem 1.4rem 1.2rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / .05), 0 12px 28px -14px rgb(0 0 0 / .3); transition: transform .35s ease, border-color .2s; }
  .fc-card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .fc-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .fc-card.flip { animation: fc-flip .35s ease; }
  @keyframes fc-flip { 50% { transform: rotateY(90deg); } }
  .fc-label { font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); font-weight: 700; }
  .fc-front { font-size: 1.25rem; font-weight: 650; line-height: 1.35; max-width: 40ch; }
  .fc-back { font-family: var(--read-font); font-size: calc(var(--read-size) * .92); line-height: 1.55; max-width: 58ch; text-align: left; }
  .fc-back[hidden], .fc-face[hidden] { display: none; }
  .fc-back p { margin: 0 0 .5em; }
  .fc-hint { font-size: .72rem; color: var(--muted); }
  .fc-rate { display: flex; gap: .4rem; justify-content: center; margin-top: .7rem; }
  .fc-rate[hidden] { display: none; }
  .fc-rate button { font: inherit; font-size: .88rem; font-weight: 600; border: 1px solid var(--line); background: var(--bg); color: var(--fg); border-radius: 10px; padding: .5rem 1rem; cursor: pointer; }
  .fc-rate button[data-rate=si]:hover { border-color: var(--ok); color: var(--ok); }
  .fc-rate button[data-rate=casi]:hover { border-color: var(--warn); color: var(--warn); }
  .fc-rate button[data-rate=no]:hover { border-color: var(--bad); color: var(--bad); }
  .fc-rate kbd { font-size: .68rem; opacity: .55; margin-left: .2rem; }
</style>

<script>
  import { isDue, sessionOrder, type Rating } from '@tk/practice';
  import { store, userCardsKey, type UserCard } from '../lib/store.ts';
  import { loadSrs, recordReview } from '../lib/srs.ts';

  type Card = { key: string; front: string; back: string; group: string; label?: string; text?: boolean };
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  document.querySelectorAll<HTMLElement>('[data-fc]').forEach((root) => {
    const { module: mod, topic, mode, limit, user } = root.dataset as Record<string, string>;
    let cards: Card[] = JSON.parse(root.querySelector('script')!.textContent || '[]');
    if (user) {
      const mine = store.get<UserCard[]>(userCardsKey(mod), []).filter((c) => !topic || c.topic === topic);
      cards = [...cards, ...mine.map((c) => ({ key: `u:${c.id}`, front: esc(c.front), back: `<p>${esc(c.back)}</p>`, group: c.topic ?? 'mias', label: 'Tu tarjeta' }))];
    }
    const srs = loadSrs(mod);
    if (mode === 'due') cards = sessionOrder(cards, srs, Date.now(), Number(limit) || 20).filter((c) => isDue(srs[c.key]));
    const card = root.querySelector<HTMLButtonElement>('.fc-card')!;
    const front = root.querySelector<HTMLElement>('.fc-front')!;
    const back = root.querySelector<HTMLElement>('.fc-back')!;
    const label = root.querySelector<HTMLElement>('.fc-label')!;
    const rate = root.querySelector<HTMLElement>('.fc-rate')!;
    const count = root.querySelector<HTMLElement>('.fc-count')!;
    const empty = root.querySelector<HTMLElement>('.fc-empty')!;
    let i = 0, flipped = false, done = 0;

    if (!cards.length) {
      root.querySelector<HTMLElement>('.fc-stage')!.hidden = true;
      root.querySelector<HTMLElement>('.fc-bar')!.hidden = true;
      empty.hidden = false;
      empty.textContent = mode === 'due' ? 'Nada pendiente de repaso por hoy. Vuelve mañana o practica en los subtemas.' : 'Aún no hay tarjetas aquí.';
      return;
    }
    function paint() {
      const c = cards[i];
      front.innerHTML = c.front;
      back.innerHTML = c.back;
      label.textContent = c.label ?? '';
      back.hidden = !flipped;
      front.hidden = flipped && c.back.length > 280; // respuestas largas: solo la respuesta al girar
      rate.hidden = !flipped;
      const st = srs[c.key];
      count.textContent = `${i + 1} / ${cards.length}${mode === 'due' ? ` · repasadas hoy ${done}` : ''}${st ? ` · caja ${st.box}` : ' · nueva'}`;
    }
    const flip = () => {
      flipped = !flipped;
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { card.classList.remove('flip'); void card.offsetWidth; card.classList.add('flip'); }
      setTimeout(paint, 170);
    };
    const go = (d: number) => { i = (i + d + cards.length) % cards.length; flipped = false; paint(); };
    card.addEventListener('click', flip);
    root.querySelector('[data-act=prev]')!.addEventListener('click', () => go(-1));
    root.querySelector('[data-act=next]')!.addEventListener('click', () => go(1));
    root.querySelector('[data-act=shuffle]')!.addEventListener('click', () => { cards = cards.map((c) => [Math.random(), c] as const).sort((a, b) => a[0] - b[0]).map((x) => x[1]); i = 0; flipped = false; paint(); });
    rate.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-rate]');
      if (!b) return;
      srs[cards[i].key] = recordReview(mod, cards[i].key, b.dataset.rate as Rating);
      done++;
      go(1);
    });
    root.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).matches('input, textarea')) return;
      if (e.key === ' ' && document.activeElement === card) { e.preventDefault(); flip(); }
      if (e.key === 'ArrowRight') go(1);
      if (e.key === 'ArrowLeft') go(-1);
      if (flipped && ['1', '2', '3'].includes(e.key)) rate.querySelectorAll<HTMLButtonElement>('button')[Number(e.key) - 1].click();
    });
    paint();
  });
</script>
